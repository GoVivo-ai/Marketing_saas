# ── App ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Postgres — Neon, Supabase or any Postgres) ───────────────
DATABASE_URL=postgresql://user:password@host:5432/vivo_marketing

# ── Platform-managed credentials ───────────────────────────────────────
# The Meta system-user token and the Anthropic API key are configured FROM
# THE PLATFORM (Settings → Connections, admin only) and stored encrypted in
# the app_settings table. The variables below are optional local-development
# fallbacks only — production deployments should not set them.
ANTHROPIC_API_KEY=
META_ACCESS_TOKEN=

# ── Cron / Sync ────────────────────────────────────────────────────────
# Shared secret required by /api/cron/sync (sent as Authorization: Bearer)
CRON_SECRET=

# ── Encryption key for stored platform tokens (32 bytes, base64) ──────
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── RingCentral (per-user click-to-call + SMS) ─────────────────────────
# One RingCentral app registered by the agency. Each user self-connects via
# OAuth from Settings → General. Redirect URI to register in the RC console:
#   ${NEXT_PUBLIC_APP_URL}/api/ringcentral/callback
# Enable app scopes: RingOut, SMS, ReadAccounts. The active environment is an
# agency-wide toggle (Settings → General, admin only); each environment has its
# OWN credentials. Production:
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
# Sandbox (optional — required only if you switch the toggle to Sandbox). These
# are a SEPARATE RingCentral app in the sandbox environment, not the same creds.
RINGCENTRAL_SANDBOX_CLIENT_ID=
RINGCENTRAL_SANDBOX_CLIENT_SECRET=
RINGCENTRAL_SANDBOX_SERVER_URL=https://platform.devtest.ringcentral.com

# ── Dialpad (per-user click-to-call + SMS) ─────────────────────────────
# One Dialpad OAuth app registered by the agency. Each user self-connects via
# OAuth from Settings → General. Redirect URI to register in the Dialpad app:
#   ${NEXT_PUBLIC_APP_URL}/api/dialpad/callback
# Server URL: sandbox = https://sandbox.dialpad.com · production =
# https://dialpad.com. DIALPAD_SCOPES is optional — a space-separated list of
# any extra scopes your Dialpad app was approved for (basic access by default).
DIALPAD_CLIENT_ID=
DIALPAD_CLIENT_SECRET=
DIALPAD_SERVER_URL=https://sandbox.dialpad.com
DIALPAD_SCOPES=

# ── Email from the agent's own mailbox (Gmail / Outlook) ───────────────
# Users connect their mailbox from Settings → General (or straight from the
# Contact Queue's Email button) and lead emails go out from their address.
# Gmail reuses the Google SSO client above (AUTH_GOOGLE_ID/SECRET): enable the
# Gmail API on that project and add this redirect URI:
#   ${NEXT_PUBLIC_APP_URL}/api/mail/gmail/callback
# Outlook reuses the Entra app (MS_CLIENT_ID + MS_GRAPH_CLIENT_SECRET) unless
# the MS_MAIL_* overrides below are set. That registration needs delegated
# Mail.Send + User.Read, "accounts in any org directory + personal" (for the
# default `common` tenant) and this redirect URI:
#   ${NEXT_PUBLIC_APP_URL}/api/mail/outlook/callback
MS_MAIL_CLIENT_ID=
MS_MAIL_CLIENT_SECRET=
MS_MAIL_TENANT=common

# ── Demo mode (optional) ─────────────────────────────────────────────────
# Seed the anonymized demo workspace with `npx tsx scripts/seed-demo.ts`,
# then share <app-url>/demo. If DEMO_ACCESS_KEY is set, the link becomes
# /demo?key=<value> — leave it empty for a fully public demo link.
DEMO_ACCESS_KEY=
