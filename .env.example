# ── App ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Postgres — Neon, Supabase or any Postgres) ───────────────
DATABASE_URL=postgresql://user:password@host:5432/vivo_marketing

# ── AI (Anthropic Claude via Vercel AI SDK) ────────────────────────────
ANTHROPIC_API_KEY=

# ── Meta (Facebook/Instagram) Marketing API ────────────────────────────
META_APP_ID=
META_APP_SECRET=
# System-user token with ads_read + leads_retrieval. Per-workspace tokens
# are stored encrypted in the `connections` table after OAuth.
META_ACCESS_TOKEN=

# ── Google Ads API (Phase 2) ───────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# ── Cron / Sync ────────────────────────────────────────────────────────
# Shared secret required by /api/cron/sync (sent as Authorization: Bearer)
CRON_SECRET=

# ── Encryption key for stored platform tokens (32 bytes, base64) ──────
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
