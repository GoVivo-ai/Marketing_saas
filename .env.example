# ── App ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Postgres — Neon, Supabase or any Postgres) ───────────────
DATABASE_URL=postgresql://user:password@host:5432/vivo_marketing

# ── Platform-managed credentials ───────────────────────────────────────
# The Meta system-user token and the Anthropic API key are configured FROM
# THE PLATFORM (Settings → Connections, admin only) and stored encrypted in
# the app_settings table. The variables below are optional local-development
# fallbacks only — production deployments should not set them.
ANTHROPIC_API_KEY=
META_ACCESS_TOKEN=

# ── Cron / Sync ────────────────────────────────────────────────────────
# Shared secret required by /api/cron/sync (sent as Authorization: Bearer)
CRON_SECRET=

# ── Encryption key for stored platform tokens (32 bytes, base64) ──────
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
